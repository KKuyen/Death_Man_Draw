# Copy to infra/.env (never commit). Placeholders only.
POSTGRES_PASSWORD=change-me
# Local fallback (plain HTTP on :80):
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://localhost
PUBLIC_WS_URL=ws://localhost
# Production with TLS (DNS A/AAAA record must point at this host, ports 80+443 open):
# SITE_ADDRESS=game.example.com
# PUBLIC_ORIGIN=https://game.example.com
# PUBLIC_WS_URL=wss://game.example.com
