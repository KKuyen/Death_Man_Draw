{
  "name": "@saloon/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --alias:@saloon/rules=../../packages/rules/src/index.ts --alias:@saloon/content=../../packages/content/src/index.ts --alias:@saloon/protocol=../../packages/protocol/src/index.ts --alias:@saloon/bots=../../packages/bots/src/index.ts --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.35",
    "@colyseus/ws-transport": "^0.18.4",
    "@saloon/content": "*",
    "@saloon/protocol": "*",
    "@saloon/rules": "*",
    "@saloon/bots": "*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.25.0"
  }
}
